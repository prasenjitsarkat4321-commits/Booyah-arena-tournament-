{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered Free Fire player profile, wallet balance, and career stats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "User verified email address"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Unique player username"
        },
        "mobileNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Player mobile number"
        },
        "referralCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "description": "Compulsory referral code used during signup"
        },
        "myReferralCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$",
          "description": "Unique shareable referral code belonging to this user"
        },
        "referredByCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "description": "Friend referral code that successfully credited bonus"
        },
        "referredByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the user who referred this player"
        },
        "referralRewardClaimed": {
          "type": "boolean",
          "description": "Whether this user has already claimed a one-time referral welcome bonus"
        },
        "referralCount": {
          "type": "number",
          "description": "Total number of verified friends referred by this user"
        },
        "referralEarningsCoins": {
          "type": "number",
          "description": "Total Booyah Coins earned via referrals"
        },
        "referralEarningsCash": {
          "type": "number",
          "description": "Total INR wallet cash earned via referrals"
        },
        "ign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Free Fire In-Game Name"
        },
        "ffUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30,
          "description": "Free Fire Player UID"
        },
        "walletBalance": {
          "type": "number",
          "description": "Real INR balance"
        },
        "coinsBalance": {
          "type": "number",
          "description": "Booyah reward coins"
        },
        "matchesPlayed": {
          "type": "number"
        },
        "totalKills": {
          "type": "number"
        },
        "booyahs": {
          "type": "number"
        },
        "joinedTournamentIds": {
          "type": "array",
          "description": "List of tournament IDs joined by the user"
        },
        "claimedDailyRewardDate": {
          "type": "string",
          "maxLength": 40
        },
        "isBanned": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": ["player", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "name",
        "ign",
        "ffUid",
        "walletBalance",
        "coinsBalance",
        "matchesPlayed",
        "totalKills",
        "booyahs",
        "joinedTournamentIds",
        "isBanned",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Real-time Free Fire esports tournament listing and slot roster.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "titleHi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "mode": {
          "type": "string",
          "enum": ["SOLO", "DUO", "SQUAD", "CLASH_SQUAD"]
        },
        "map": {
          "type": "string",
          "enum": ["Bermuda", "Purgatory", "Kalahari", "Alpine", "NexTerra"]
        },
        "bannerImage": {
          "type": "string",
          "maxLength": 500
        },
        "prizePool": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "COINS"]
        },
        "entryFee": {
          "type": "number"
        },
        "perKillPrize": {
          "type": "number"
        },
        "firstPlacePrize": {
          "type": "number"
        },
        "secondPlacePrize": {
          "type": "number"
        },
        "thirdPlacePrize": {
          "type": "number"
        },
        "totalSlots": {
          "type": "number"
        },
        "filledSlots": {
          "type": "number"
        },
        "startTime": {
          "type": "string",
          "maxLength": 80
        },
        "roomId": {
          "type": "string",
          "maxLength": 40
        },
        "roomPassword": {
          "type": "string",
          "maxLength": 40
        },
        "roomUnlocksAt": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["UPCOMING", "ROOM_OPEN", "LIVE", "COMPLETED"]
        },
        "organizer": {
          "type": "string",
          "maxLength": 80
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128
        },
        "isVerified": {
          "type": "boolean"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "deviceType": {
          "type": "string",
          "enum": ["MOBILE_ONLY", "ALL_DEVICES"]
        },
        "gunAttributes": {
          "type": "boolean"
        },
        "visibility": {
          "type": "string",
          "enum": ["PUBLIC"]
        },
        "slots": {
          "type": "array"
        },
        "rules": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "titleHi",
        "mode",
        "map",
        "bannerImage",
        "prizePool",
        "currency",
        "entryFee",
        "perKillPrize",
        "firstPlacePrize",
        "secondPlacePrize",
        "thirdPlacePrize",
        "totalSlots",
        "filledSlots",
        "startTime",
        "roomUnlocksAt",
        "status",
        "organizer",
        "createdByUid",
        "isVerified",
        "deviceType",
        "gunAttributes",
        "visibility",
        "slots",
        "rules",
        "createdAt",
        "updatedAt"
      ]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Manual UPI QR wallet top-up request awaiting admin approval.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "maxLength": 150
        },
        "userName": {
          "type": "string",
          "maxLength": 80
        },
        "userIgn": {
          "type": "string",
          "maxLength": 40
        },
        "amount": {
          "type": "number"
        },
        "upiTransactionId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "payerUpiId": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 200
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "userEmail",
        "userName",
        "userIgn",
        "amount",
        "upiTransactionId",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "WithdrawRequest": {
      "title": "WithdrawRequest",
      "description": "Player cash withdrawal request via UPI.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 80
        },
        "userIgn": {
          "type": "string",
          "maxLength": 40
        },
        "amount": {
          "type": "number"
        },
        "upiId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "COMPLETED", "REJECTED"]
        },
        "payoutRef": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "userIgn",
        "amount",
        "upiId",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet and Booyah Coins passbook ledger entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["DEPOSIT", "WITHDRAW", "ENTRY_FEE", "PRIZE_WON", "DAILY_BONUS", "REFERRAL_BONUS"]
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "COINS"]
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "descriptionHi": {
          "type": "string",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "PENDING", "FAILED"]
        },
        "referenceId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "type",
        "amount",
        "currency",
        "description",
        "descriptionHi",
        "date",
        "status",
        "createdAt"
      ]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Platform UPI QR merchant settings configured by Admin.",
      "type": "object",
      "properties": {
        "upiId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80
        },
        "merchantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "instructions": {
          "type": "string",
          "maxLength": 300
        },
        "qrImageUrl": {
          "type": "string",
          "maxLength": 350000,
          "description": "Personal UPI QR code image URL or compressed base64 data URI"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["upiId", "merchantName", "instructions", "updatedAt"]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Public non-PII lookup index mapping a unique referral code to its owner UID and IGN.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerIgn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "totalUses": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "ownerUid", "ownerIgn", "totalUses", "createdAt", "updatedAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Immutable record of a completed two-way referral reward between referrer and referred user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referrerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "referrerIgn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "referrerCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "referredUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "referredIgn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "referrerBonusCoins": { "type": "number" },
        "referrerBonusCash": { "type": "number" },
        "referredBonusCoins": { "type": "number" },
        "referredBonusCash": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["CREDITED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "referrerUid",
        "referrerIgn",
        "referrerCode",
        "referredUid",
        "referredIgn",
        "referrerBonusCoins",
        "referrerBonusCash",
        "referredBonusCoins",
        "referredBonusCash",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile, wallet balance, referral stats, and joined tournaments"
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Live tournaments catalog synced in real time across all users"
    },
    "/depositRequests/{requestId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "Manual UPI QR deposit requests with UTR / Transaction ID for Admin approval"
    },
    "/withdrawRequests/{requestId}": {
      "schema": { "$ref": "#/entities/WithdrawRequest" },
      "description": "User UPI withdrawal requests reviewed by Admin"
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Per-user wallet passbook transaction history"
    },
    "/platformConfig/{configId}": {
      "schema": { "$ref": "#/entities/PaymentSettings" },
      "description": "Admin-managed UPI QR merchant configuration"
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Public non-PII referral code directory for resolving friend invite codes"
    },
    "/referrals/{referredUid}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Immutable per-user referral reward ledger"
    }
  }
}
